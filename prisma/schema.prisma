// ============================================================
// EB FCST App — Prisma Schema
// 기존 Samsung FCST Tracker(Excel)의 데이터 모델을 그대로 계승,
// Emerging Biotech 다수 고객 환경으로 확장
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================================================================
// ENUMS
// ===================================================================

enum UserRole {
  ADMIN   // 시스템 관리자: 모든 기능 + 잠금 + 사용자 관리 + Excel 내보내기
  EDITOR  // 편집자: FCST 입력/수정, 메모, 노트 (잠금·내보내기 불가)
  VIEWER  // 조회자: 읽기 전용 (내보내기 불가)
}

enum CustomerTier {
  A // Top 20%: 라인-레벨 수동 입력 + Pipeline 기반 Forecasting
  B // Next 30%: Run-rate 자동 제안 + AM 검토
  C // Long-tail 50%: Statistical baseline 자동 생성
}

enum LifecycleStage {
  DISCOVERY   // 탐색 단계
  PRECLIN     // 전임상
  PHASE1      // 임상 1상
  PHASE2      // 임상 2상
  PHASE3      // 임상 3상
  COMMERCIAL  // 상업화 단계
}

// 기존 Excel 컬럼 셋(December/January/.../November)과 1:1 대응
enum SnapshotMonth {
  DECEMBER   // 연간 예산 확정
  JANUARY
  FEBRUARY
  APRIL
  JUNE
  AUGUST
  OCTOBER
  NOVEMBER   // 연말 최종 예측
}

enum ForecastStatus {
  DRAFT      // 작성 중
  SUBMITTED  // 제출 완료 (Manager 검토 대기)
  APPROVED   // Manager 승인
  LOCKED     // 잠금 (이후 변경은 R&O로만 반영)
}

enum ROType {
  RISK         // 위험 요소 (−): FCST에 포함된 수치
  OPPORTUNITY  // 기회 요소 (+): FCST 미포함 상향 가능성
  NON_REPEATED // 1회성 주문
  DROPSHIP     // 직송 주문
}

enum ROLevel {
  H // Weighted probability 0.75
  M // Weighted probability 0.50
  L // Weighted probability 0.25
}

enum Currency {
  KRW
  EUR
  USD
}

// SFDC Opportunity Stage → win rate 매핑용
enum SfdcStage {
  IDENTIFIED  // 10%
  QUALIFIED   // 30%
  PROPOSAL    // 50%
  NEGOTIATION // 75%
  WON         // 100%
  LOST        // 0%
}

// ===================================================================
// MASTER: USERS
// ===================================================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String             // 한국어 이름 (e.g., "김현중")
  name_en    String?            // 영문 이름 (e.g., "HyeonJoong Kim")
  role       UserRole @default(VIEWER)
  password   String?            // bcrypt hash (SSO 미사용 시)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customers_owned   Customer[]     @relation("CustomerOwner")
  forecast_lines    ForecastLine[] @relation("ForecastOwner")
  forecast_updates  ForecastLine[] @relation("ForecastUpdater")
  ro_items          ROItem[]       @relation("ROCreator")
  snapshots_frozen  FcstSnapshot[] @relation("SnapshotFrozenBy")
  audit_logs        AuditLog[]

  @@map("users")
}

// ===================================================================
// MASTER: CUSTOMERS (EB 고객사)
// ===================================================================

model Customer {
  id              String         @id @default(cuid())
  sold_to_code    String         @unique  // BIS Sold-to 코드 (e.g., "EB-00123")
  name            String                  // 회사명 한글 (e.g., "셀트리온")
  name_en         String?                 // 영문명 (e.g., "Celltrion")
  tier            CustomerTier   @default(C)
  lifecycle_stage LifecycleStage @default(DISCOVERY)
  region          String?        // "수도권" | "충청" | "영남" | "호남"
  address         String?
  phone           String?
  owner_id        String         // 담당 AM
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  owner          User               @relation("CustomerOwner", fields: [owner_id], references: [id])
  forecast_lines ForecastLine[]
  actuals        Actual[]
  ro_items       ROItem[]
  snapshot_lines FcstSnapshotLine[]
  row_comments   FcstRowComment[]
  memos          FcstCustomerMemo[]

  @@index([owner_id])
  @@index([tier])
  @@index([lifecycle_stage])
  @@map("customers")
}

// ===================================================================
// MASTER: PRODUCTS (7-Tier SBU 계층)
// ===================================================================
// Samsung Excel 계층: 대분류(BIS) → 거래처 → 대분류(삼성팀) → 소분류(삼성팀)
//                      → BU(SDV)  → BD       → BD_2         → SBU(PG)
// EB App에서는 고객별 Sold-to 종속이 없으므로 상위 4계층은 제거,
// BU / BD / BD_2 / SBU 4계층만 유지하고 조회용으로 상위 컨텍스트 보존
// ===================================================================

model Product {
  id          String  @id @default(cuid())

  // Tier 5: Business Unit (SDV)
  bu_code     String  // "LP2" | "LP3"
  bu_name     String  // "BioProcessing" | "Process & Formulation Materials"

  // Tier 6: Business Field (BD)
  bf_code     String  // "C22" | "C24" | "C25" | "C26" | "C27" | "C23" | "C28" | "C29"
  bf_name     String  // "Cell Culture" | "Single-Use/Hardware" | ...

  // Tier 6b: BD_2 (세부 그룹)
  bf2_code    String? // "L7 Cell Culture - MM" | "LL Cell Culture - SIAL" | ...
  bf2_name    String? // 표시용

  // Tier 7: Product Group (SBU)
  sbu_code    String  // "674" | "738" | "P21" | ...
  sbu_name    String  // "Cell Culture Media" | "Durapore Cartridges & Capsules" | ...

  // 편의 분류 (삼성팀 소분류와 대응)
  samsung_sub String? // "CCM, Chrom" | "Filters" | "HWs" | "SU" | "BPM"

  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  forecast_lines ForecastLine[]
  actuals        Actual[]
  ro_items       ROItem[]
  snapshot_lines FcstSnapshotLine[]
  row_comments   FcstRowComment[]

  @@unique([bu_code, bf_code, sbu_code])
  @@index([bu_code])
  @@index([bf_code])
  @@index([sbu_code])
  @@map("products")
}

// ===================================================================
// MASTER: FX RATES
// ===================================================================

model FxRate {
  id             String   @id @default(cuid())
  year           Int
  currency       Currency // EUR | USD (기준은 항상 KRW)
  rate           Decimal  @db.Decimal(12, 4) // 1 EUR = rate KRW
  is_op_rate     Boolean  @default(false)    // true = OP FX (고정), false = Actual FX
  effective_from DateTime
  note           String?  // "EUR/KRW OP26: 1,409" 등
  created_at     DateTime @default(now())
  created_by     String?

  @@unique([year, currency, is_op_rate])
  @@map("fx_rates")
}

// ===================================================================
// FORECAST LINES (장형 포맷 — Excel 가로 wide 포맷은 view에서 pivot)
// ===================================================================

model ForecastLine {
  id               String         @id @default(cuid())
  customer_id      String
  product_id       String
  year             Int
  quarter          Int            // 1 | 2 | 3 | 4
  snapshot_month   SnapshotMonth

  // 금액 (입력 통화 기준)
  amount           Decimal        @db.Decimal(18, 4)
  currency         Currency       @default(KRW)
  // KRW 환산 (OP FX 자동 적용)
  amount_krw       Decimal?       @db.Decimal(18, 4)

  // 워크플로우
  status           ForecastStatus @default(DRAFT)

  // 정확도·품질
  confidence_score Int?           @default(0)   // 0–100: 입력 충실도 + 과거 정확도
  is_highlighted   Boolean        @default(false) // 노란 셀 컨벤션 (변경 셀)

  // SFDC 연동 (Pipeline-aware)
  sfdc_oppty_id    String?
  sfdc_stage       SfdcStage?
  sfdc_win_rate    Decimal?       @db.Decimal(5, 4) // 자동 매핑 but AM 오버라이드 가능

  // 코멘트 (500K KRW 이상 필수)
  comment          String?
  prev_amount_krw  Decimal?       @db.Decimal(18, 4) // 이전 snapshot 값 (diff 계산용)

  owner_id         String
  updated_by       String
  updated_at       DateTime       @updatedAt
  created_at       DateTime       @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])
  owner    User     @relation("ForecastOwner", fields: [owner_id], references: [id])
  updater  User     @relation("ForecastUpdater", fields: [updated_by], references: [id])

  @@unique([customer_id, product_id, year, quarter, snapshot_month])
  @@index([customer_id])
  @@index([product_id])
  @@index([year, quarter])
  @@index([snapshot_month])
  @@index([status])
  @@index([owner_id])
  @@map("forecast_lines")
}

// ===================================================================
// ACTUALS (BIS / SRM ETL 수신)
// ===================================================================

model Actual {
  id          String   @id @default(cuid())
  customer_id String
  product_id  String
  year        Int
  quarter     Int      // 1–4
  amount_krw  Decimal  @db.Decimal(18, 4)
  source      String   // "BIS" | "SRM" | "OpenPO" | "Manual"
  ingested_at DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  @@unique([customer_id, product_id, year, quarter, source])
  @@index([customer_id])
  @@index([year, quarter])
  @@map("actuals")
}

// ===================================================================
// R&O (Risk & Opportunity) — 기존 2025/2026 R&O 시트 구조화
// ===================================================================

model ROItem {
  id                  String   @id @default(cuid())
  customer_id         String
  product_id          String?  // null = BF(Business Field) 단위 R&O
  bf_code             String?  // product_id가 null일 때 BF 레벨 매핑
  year                Int
  quarter             Int?     // null = 연간 단위

  type                ROType
  level               ROLevel
  weight              Decimal  @db.Decimal(5, 4) // H=0.7500, M=0.5000, L=0.2500

  raw_amount          Decimal  @db.Decimal(18, 4) // 입력 통화 (M EUR 단위 입력 관행)
  currency            Currency @default(EUR)
  weighted_amount_krw Decimal  @db.Decimal(18, 4) // raw × weight × OP FX rate

  sfdc_link           String?  // SFDC Opportunity URL
  comment             String   // 필수 기재 (500K KRW 이상은 상세 사유)
  requires_detail     Boolean  @default(false) // 500K+ 플래그

  created_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  customer Customer  @relation(fields: [customer_id], references: [id])
  product  Product?  @relation(fields: [product_id], references: [id])
  creator  User      @relation("ROCreator", fields: [created_by], references: [id])

  @@index([customer_id])
  @@index([year])
  @@index([type])
  @@map("ro_items")
}

// ===================================================================
// SNAPSHOTS — 매월 cut-off 시 자동 잠금
// ===================================================================

model FcstSnapshot {
  id             String        @id @default(cuid())
  snapshot_month SnapshotMonth
  year           Int
  frozen_at      DateTime      @default(now())
  frozen_by      String

  frozen_by_user User               @relation("SnapshotFrozenBy", fields: [frozen_by], references: [id])
  lines          FcstSnapshotLine[]

  @@unique([snapshot_month, year])
  @@map("fcst_snapshots")
}

model FcstSnapshotLine {
  id          String  @id @default(cuid())
  snapshot_id String
  customer_id String
  product_id  String
  year        Int
  quarter     Int
  amount_krw  Decimal @db.Decimal(18, 4)

  snapshot FcstSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customer_id], references: [id])
  product  Product      @relation(fields: [product_id], references: [id])

  @@unique([snapshot_id, customer_id, product_id, year, quarter])
  @@index([snapshot_id])
  @@map("fcst_snapshot_lines")
}

// ===================================================================
// AUDIT LOG — 누가·언제·왜 변경했는지 (변경 불가 append-only)
// ===================================================================

model AuditLog {
  id      String   @id @default(cuid())
  table   String   // "forecast_lines" | "ro_items" | ...
  row_id  String
  before  Json?
  after   Json?
  user_id String
  ts      DateTime @default(now())
  reason  String?  // Locked 이후 수정 시 사유 필수

  user User @relation(fields: [user_id], references: [id])

  @@index([table, row_id])
  @@index([user_id])
  @@index([ts])
  @@map("audit_log")
}

// ===================================================================
// FCST ROW COMMENTS — 행별 코멘트 (vs LY, vs Prev FCST)
// ===================================================================

model FcstRowComment {
  id             String        @id @default(cuid())
  customer_id    String
  product_id     String
  year           Int
  snapshot_month SnapshotMonth

  ly_comment     String?   // vs LY 사유·코멘트
  prev_comment   String?   // vs Previous FCST 변동 사유·코멘트

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  @@unique([customer_id, product_id, year, snapshot_month])
  @@index([customer_id])
  @@index([year, snapshot_month])
  @@map("fcst_row_comments")
}

// ===================================================================
// FCST CELL NOTES — Q1~Q4 셀별 메모 (엑셀 셀 코멘트와 동일)
// ===================================================================

model FcstCellNote {
  id             String        @id @default(cuid())
  customer_id    String
  product_id     String
  year           Int
  quarter        Int           // 1 | 2 | 3 | 4
  snapshot_month SnapshotMonth
  note           String        @db.Text
  updated_by     String
  updated_at     DateTime      @updatedAt
  created_at     DateTime      @default(now())

  @@unique([customer_id, product_id, year, quarter, snapshot_month])
  @@index([customer_id])
  @@index([year, snapshot_month])
  @@map("fcst_cell_notes")
}

// ===================================================================
// FCST CUSTOMER MEMOS — 고객 탭별 자유 메모 (스냅샷 월 단위)
// ===================================================================

model FcstCustomerMemo {
  id             String        @id @default(cuid())
  customer_id    String
  year           Int
  snapshot_month SnapshotMonth
  memo           String        @db.Text
  updated_by     String
  updated_at     DateTime      @updatedAt
  created_at     DateTime      @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, year, snapshot_month])
  @@index([customer_id])
  @@index([year, snapshot_month])
  @@map("fcst_customer_memos")
}

// ===================================================================
// MANAGER TARGETS (Top-down 목표 — Bottom-up Gap 시각화용)
// ===================================================================

model ManagerTarget {
  id       String @id @default(cuid())
  year     Int
  quarter  Int?   // null = 연간
  bf_code  String // Business Field 단위 목표
  amount_krw Decimal @db.Decimal(18, 4)
  set_by   String
  set_at   DateTime @default(now())
  note     String?

  @@unique([year, quarter, bf_code])
  @@map("manager_targets")
}
