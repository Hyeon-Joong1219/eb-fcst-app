# ────────────────────────────────────────────────────────────────
# EB FCST App — 환경 변수 예시
# 이 파일을 복사하여 .env 로 저장 후 실제 값으로 교체하세요.
# .env는 절대 Git에 커밋하지 마세요.
# ────────────────────────────────────────────────────────────────

# PostgreSQL 접속 URL (필수)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/eb_fcst?schema=public"

# NextAuth (필수)
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# SFDC 연동 (Phase 4, 지금은 mock)
SFDC_CLIENT_ID=""
SFDC_CLIENT_SECRET=""
SFDC_INSTANCE_URL=""

# 이메일 알림 (옵션)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
